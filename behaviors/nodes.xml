<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!-- The custom nodes implemented by the robot application. -->
  <TreeNodesModel>
    <Action ID="MoveTo">
      <input_port name="goal" type="Pose2D">Where to go</input_port>
      <input_port name="speed" type="double" default="0.5">Linear speed, in m/s</input_port>
      <description>Drives the base to a pose.</description>
    </Action>
    <Action ID="DetectObject">
      <input_port name="object_id" type="std::string">The object to look for</input_port>
      <output_port name="pose" type="Pose2D">Where the object is</output_port>
      <description>Finds an object with the camera.</description>
    </Action>
    <Action ID="OpenGripper"/>
    <Action ID="CloseGripper">
      <input_port name="force" type="double" default="10.0">Grip force, in N</input_port>
    </Action>
    <Action ID="Say">
      <input_port name="message" type="std::string"/>
    </Action>
    <Action ID="Dock">
      <input_port name="station" type="Pose2D"/>
    </Action>
    <Action ID="Charge">
      <input_port name="target_level" type="double" default="100">Charge until this level, in percent</input_port>
    </Action>
    <Condition ID="IsBatteryOk">
      <input_port name="min_level" type="double" default="20">Minimum charge, in percent</input_port>
      <description>Succeeds while the battery is above min_level.</description>
    </Condition>
    <Condition ID="IsHoldingObject"/>
  </TreeNodesModel>
</root>
