<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="PickAndPlace">
  <BehaviorTree ID="PickAndPlace">
    <Sequence>
      <SubTree ID="Pick" object="{object}" pose="{object_pose}"/>
      <MoveTo goal="{destination}"/>
      <OpenGripper/>
      <Say message="Delivered"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Pick">
    <Sequence>
      <!-- Look around a few times before giving up. -->
      <RetryUntilSuccessful num_attempts="3">
        <DetectObject object_id="{object}" pose="{pose}"/>
      </RetryUntilSuccessful>
      <MoveTo goal="{pose}" speed="0.2"/>
      <CloseGripper/>
      <IsHoldingObject/>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="PickAndPlace">
      <input_port name="object"/>
      <input_port name="destination"/>
    </SubTree>
    <SubTree ID="Pick">
      <input_port name="object"/>
      <output_port name="pose"/>
    </SubTree>
  </TreeNodesModel>
</root>
